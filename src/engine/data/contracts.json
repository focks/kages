      },
      "value": {
        "type": "string",
        "default": null
      }
    },
    "events": {
      "select": {
        "handler": "onSelect",
        "payload": {
          "id": "string"
        }
      },
      "toggle": {
        "handler": "onToggle",
        "payload": {}
      }
    },
    "commands": {
      "toggle": [
        {
          "do": "setLocal",
          "key": "collapsed",
          "value": {
            "$not": {
              "$self": "collapsed"
            }
          }
        }
      ],
      "collapse": [
        {
          "do": "setLocal",
          "key": "collapsed",
          "value": true
        }
      ],
      "expand": [
        {
          "do": "setLocal",
          "key": "collapsed",
          "value": false
        }
      ]
    },
    "defaults": {
      "select": [
        {
          "do": "setLocal",
          "key": "value",
          "value": {
            "$event": "id"
          }
        }
      ],
      "toggle": [
        {
          "do": "call",
          "target": "$self",
          "command": "toggle"
        }
      ]
    },
    "outputs": [
      "value",
      "collapsed"
    ],
    "tokens": [
