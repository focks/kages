{
  "root": "page",
  "state": { "form": { "plan": "free", "email": "", "agree": false }, "tab": "plan", "seats": 5 },
  "elements": {
    "page": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg" }, "children": ["card", "skel"] },
    "card": { "type": "Card", "props": { "title": "Choose a plan", "description": "You can change it later" }, "children": ["h", "plan", "email", "seats", "total", "agree", "go", "oops", "tbl", "faq", "sep", "ext"] },
    "h": { "type": "Heading", "props": { "text": "Welcome", "level": "h1" } },
    "plan": { "type": "Radio", "props": { "label": "Plan", "name": "plan", "options": ["free", "team"], "value": { "$bindState": "/form/plan" } } },
    "email": { "type": "Input", "props": { "label": "Email", "name": "email", "type": "email", "value": { "$bindState": "/form/email" } } },
    "seats": { "type": "Slider", "props": { "label": "Seats", "min": 1, "max": 50, "step": 1, "value": { "$bindState": "/seats" } } },
    "total": { "type": "Text", "props": { "text": { "$template": "You picked ${/form/plan} for ${/seats} seats" }, "variant": "muted" } },
    "agree": { "type": "Checkbox", "props": { "label": "I agree", "name": "agree", "checked": { "$bindState": "/form/agree" } } },
    "go": { "type": "Button", "props": { "label": "Continue", "variant": "primary" }, "on": { "press": [{ "action": "setState", "params": { "statePath": "/tab", "value": "done" } }, { "action": "sendEmail", "params": {} }] }, "visible": [{ "$state": "/form/agree" }] },
    "oops": { "type": "Alert", "props": { "title": "Please accept the terms", "message": "Tick the box to continue", "type": "warning" }, "visible": { "$state": "/form/agree", "not": true } },
    "tbl": { "type": "Table", "props": { "columns": ["Plan", "Price"], "rows": [["Free", "$0"], ["Team", "$10"]] } },
    "faq": { "type": "Accordion", "props": { "items": [{ "title": "Can I cancel?", "content": "Yes, any time." }] } },
    "sep": { "type": "Separator", "props": {} },
    "ext": { "type": "Chart3D", "props": {}, "children": [] },
    "skel": { "type": "Skeleton", "props": {} }
  }
}
