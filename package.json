{
  "name": "@ifocksh/kages",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "kages": "dist/kages.mjs"
  },
  "scripts": {
    "dev": "npm run build:frame && KAGES_NEXT_DIST_DIR=.next-dev next dev",
    "build": "npm run build:frame && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "tokens": "node scripts/kage-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "ds-integrity": "node scripts/ds-integrity.mjs",
    "build:ds": "node scripts/build-ds.mjs && node scripts/extract-data.mjs && node scripts/golden.mjs && npm run tokens && npm run check:contrast && npm run ds-integrity && npm run build:frame && npm run build:plugin",
    "build:plugin": "node scripts/build-plugin-skills.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "prepare": "node scripts/build-cli.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "check:plugins": "node scripts/build-plugins.mjs --check",
    "build:frame": "node scripts/build-frame.mjs",
    "bench:render": "NODE_ENV=production node scripts/bench-render.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.55.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "plugins",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "description": "An artifactory for agents: versioned, interactive artifacts assembled from blocks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/focks/kages.git"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    }
  },
  "homepage": "https://github.com/focks/kages#readme",
  "bugs": {
    "url": "https://github.com/focks/kages/issues"
  },
  "keywords": [
    "agents",
    "mcp",
    "artifacts",
    "design-system",
    "nextjs",
    "interactive"
  ],
  "publishConfig": {
    "access": "public"
  }
}
