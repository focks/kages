{
  "kages": "1.0",
  "id": "quarterly-report",
  "title": "Quarterly report — six ways to see the data",
  "system": "ledger@2",
  "root": "root",
  "blocks": {
    "root": {
      "type": "page",
      "props": {
        "width": "wide",
        "gap": 8
      },
      "slots": {
        "children": [
          "intro",
          "trend",
          "stack",
          "pipeline",
          "split",
          "flows",
          "regions"
        ]
      }
    },
    "intro": {
      "type": "section",
      "props": {
        "eyebrow": "Quarterly report",
        "title": "How the quarter went",
        "description": "Revenue against target, the mix behind it, the sales funnel, where costs go, how money moves and how regions compare.",
        "inset": 0
      }
    },
    "trend": {
      "type": "combo-chart",
      "props": {
        "label": "Revenue vs target",
        "xLabel": "Month",
        "categories": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "series": [
          {
            "name": "Revenue",
            "kind": "bar",
            "values": [
              120,
              135,
              150,
              142,
              170,
              190
            ]
          },
          {
            "name": "Target",
            "kind": "line",
            "values": [
              125,
              130,
              140,
              150,
              160,
              175
            ]
          }
        ]
      }
    },
    "stack": {
      "type": "stacked-bar-chart",
      "props": {
        "label": "Revenue by product line",
        "categories": [
          "Q1",
          "Q2",
          "Q3",
          "Q4"
        ],
        "series": [
          {
            "name": "Platform",
            "values": [
              60,
              70,
              85,
              95
            ]
          },
          {
            "name": "Services",
            "values": [
              30,
              32,
              35,
              38
            ]
          },
          {
            "name": "Support",
            "values": [
              20,
              22,
              21,
              25
            ]
          }
        ]
      }
    },
    "pipeline": {
      "type": "funnel-chart",
      "props": {
        "label": "Sales funnel",
        "interactive": true,
        "stages": [
          {
            "label": "Visitors",
            "value": 12000
          },
          {
            "label": "Signups",
            "value": 3400
          },
          {
            "label": "Trials",
            "value": 1200
          },
          {
            "label": "Customers",
            "value": 380
          }
        ]
      }
    },
    "split": {
      "type": "split",
      "props": {
        "ratio": "equal",
        "gap": 6
      },
      "slots": {
        "start": [
          "costs"
        ],
        "end": [
          "picked"
        ]
      }
    },
    "costs": {
      "type": "treemap",
      "props": {
        "label": "Where the budget goes",
        "interactive": true,
        "items": [
          {
            "label": "Engineering",
            "value": 48
          },
          {
            "label": "Sales",
            "value": 24
          },
          {
            "label": "Marketing",
            "value": 14
          },
          {
            "label": "Support",
            "value": 9
          },
          {
            "label": "Operations",
            "value": 5
          }
        ]
      }
    },
    "picked": {
      "type": "text",
      "props": {
        "variant": "caption"
      },
      "bind": {
        "text": {
          "$tpl": "Selected — budget area: {{block.costs.selected}} · funnel stage: {{block.pipeline.selected}} · region: {{block.regions.selected}}"
        }
      }
    },
    "flows": {
      "type": "sankey",
      "props": {
        "label": "From budget to outcomes",
        "nodes": [
          {
            "id": "budget",
            "label": "Budget"
          },
          {
            "id": "build",
            "label": "Build"
          },
          {
            "id": "grow",
            "label": "Grow"
          },
          {
            "id": "features",
            "label": "Features"
          },
          {
            "id": "fixes",
            "label": "Fixes"
          },
          {
            "id": "leads",
            "label": "Leads"
          }
