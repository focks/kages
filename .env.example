# Kages — environment. Copy to .env.local for local persistence, or set these
# in the Vercel project settings for the deploy. ALL OPTIONAL: with none set,
# the app runs fully in-memory (the default), so nothing here is required to
# run or test locally.

# Plain Postgres durable store (local or self-hosted). Create the database and
# tables with:  DATABASE_URL=... npm run db:setup
# Takes precedence over Supabase when both are set. Unix-socket example:
#   postgres:///kages_dev?host=/var/run/postgresql
# TCP example:  postgres://user:password@localhost:5432/kages_dev
DATABASE_URL=

# Supabase durable store (enable persistence). Both must be set to take effect.
# URL: your project's REST URL, e.g. https://abcdefgh.supabase.co
# KEY: the SERVICE ROLE key (server-only; bypasses RLS). NEVER expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (enable Google login + per-user workspaces). Both must be set to
# turn auth ON; without them the app has NO login (local/dev). These are the
# PUBLIC browser values — safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without both Supabase variables a built app is read-only. For a local run of a built app (never on a shared host):
# KAGES_LOCAL_MODE=1
